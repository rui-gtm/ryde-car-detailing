# Copy to .env for local dev, or set these as Vercel Environment Variables for deployment.
# Never commit real values.

# SMTP (used by services/emailService.js)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Shared secret the frontend must send as the x-api-key header (see api/quote.js)
API_KEY=
