# Copy to .env for local dev, or set these as Vercel Environment Variables for deployment.
# Never commit real values.

# SMTP (used by services/emailService.js)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Shared secret the frontend must send as the x-api-key header (see api/quote.js)
API_KEY=

# Frontend build-time var (src/components/BookingForm.tsx). Only needed when the
# static site is NOT served from the same origin as the Vercel API (e.g. hosted on
# Crazy Domains). Must be set before `npm run build` — Vite bakes it into the bundle.
# VITE_QUOTE_API_URL=https://ryde-car-detailing.vercel.app/api/quote
